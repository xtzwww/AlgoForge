# ============================================================
#  AlgoForge Sidecar — environment template
#  Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ============================================================

# --- LLM -----------------------------------------------------
LLM_PROVIDER=deepseek          # deepseek | ollama | openai_compatible
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-coder

# Ollama (offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Any other OpenAI-compatible endpoint (Agnes AI, vLLM, LM Studio, ...).
# Set LLM_PROVIDER=openai_compatible and fill in the three values below;
# no code change is needed. Include the version segment in the base URL
# if the server needs one — the gateway only appends `/v1` when the URL
# does not already carry it.
#
# The key is optional: a self-hosted server with no auth is legitimate,
# and it is omitted from the request rather than sent blank. Both
# `openai_compatible` and `openai-compatible` are accepted spellings.
#
# For a *structured-output* task like the error analysis, prefer a
# non-reasoning model: it answers directly and quickly. On Agnes AI,
# `agnes-3.0-flash` is one (no reasoning tax) while `agnes-2.5-flash` is
# a reasoning model that needs ~16000 tokens of budget per call.
#
# OPENAI_COMPATIBLE_BASE_URL=https://apihub.agnes-ai.cn/v1
# OPENAI_COMPATIBLE_API_KEY=sk-xxx
# OPENAI_COMPATIBLE_MODEL=agnes-3.0-flash
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Response cap for analysis calls, in tokens. A cap, not a target: a model
# that finishes on its own stops early and is billed only for what it
# wrote, so raising this costs nothing for a terse model.
#
# Two calibration points measured 2026-09-16, both against the four-field
# error analysis:
#   * a NON-reasoning model wrote ~6600 characters (~3k tokens), so the
#     original 800 was already too low for it;
#   * a REASONING model (agnes-2.5-flash) bills its hidden reasoning
#     against the same budget and needed 16000 — at 8000 it returned an
#     empty answer. Reasoning models need this raised by ~an order of
#     magnitude.
#
# Setting it too low does not fail politely: the reply is cut off and the
# JSON parser reports "not valid JSON", which blames formatting for what
# is really a budget mistake. The gateway now raises
# TruncatedCompletionError in that case, naming this setting.
LLM_MAX_TOKENS=4096

# Per-request timeout, in seconds. Also model dependent, for the same
# reason as the token cap: a hosted endpoint generating thousands of
# tokens takes far longer than a local 3B model writing a sentence.
#
# Setting it too low does not fail loudly as a config problem — it
# surfaces as `LLMConnectionError: timed out after Ns`, which the P2-5
# harness scores as a *model* miss. Measured 2026-09-16: at the gateway's
# 60s default, 2 of the 20 eval cases were lost that way.
LLM_TIMEOUT=60

# --- LLM guardrails (S10) ------------------------------------
# Read by app/agent/guardrails.py. NOTE: the guardrails are NOT wired into
# the judging path yet — analyzer/team still call the gateway directly —
# so changing these has no effect until a call site switches from
# `chat_completion` to `guarded_chat_completion`. That is deliberate: see
# the module docstring's "What turning this on changes".

# Redact email addresses and card numbers before the prompt is sent to a
# hosted endpoint. Student code comments can carry personal data, and the
# prompt leaves the process. IP / MAC / URL are deliberately NOT included:
# they are the subject matter of problems like IP 地址转换 / URL 解析, and
# redacting them would delete the thing being analysed.
LLM_PII_REDACTION=true

# Fallback providers to try *after* the configured one, comma separated.
# Blank means "only LLM_PROVIDER". `ollama` here is AGENTS.md §一's
# "主路径 DeepSeek API，兜底 Ollama". Names must be providers the gateway
# knows; a typo raises at policy build time rather than mid-analysis.
LLM_FALLBACK_PROVIDERS=

# Retries per provider on a *transient* failure, beyond the first call.
# 0 disables retrying.
#
# Timeouts are deliberately NOT retried by default: one timeout already
# costs the whole LLM_TIMEOUT, and retrying doubles how long a student
# waits in front of `judge_done`. What is retried is 5xx and 429 — both
# return immediately, and 429 is the textbook case for backoff.
LLM_RETRY_ATTEMPTS=1

# --- Orchestrator (S4/S7 wiring) -----------------------------
# Which orchestrator analyses a failing submission on the judging path:
#
#   direct (default) — `analyzer.analyze_error`, the S2 single call.
#   graph            — S4's LangGraph state machine (read_code → retrieve →
#                      analyse → self_check, with one self-check back edge).
#                      Retrieved knowledge cards are folded into the prompt.
#
# The default stays `direct` on purpose. The graph can cost up to 4 model
# calls per analysis against direct's 2 (each round still allows
# max_attempts=2, and the self-check may run a second round), and that
# spend happens while a student waits for `judge_done`. More importantly,
# S2's "20 道真题准确率 ≥ 60%" go/no-go line can only be measured with
# `pytest -m eval_set` — a paid, metered run that the daily suite and the
# nightly automation both skip. Flipping this without running that would
# leave nobody able to say whether accuracy moved.
#
# A value that names no pipeline falls back to `direct` and logs a warning.
ANALYSIS_PIPELINE=direct

# --- LangSmith (optional) ------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=algoforge

# --- Sidecar -------------------------------------------------
# Leave blank to auto-pick a random free port and a random token.
SIDECAR_PORT=
SIDECAR_TOKEN=

# CORS origins allowed to call the sidecar.
# Comma-separated. Use '*' to allow everything (not recommended).
#
# 5173 is the web target's dev server (`npm run dev:web`, PU-5) and 4173
# is Vite's preview server. Both are needed because the browser talks to
# the sidecar directly and therefore sends an Origin header. The Electron
# renderer needs no entry: it loads from file:// / a custom scheme, which
# sends no Origin at all.
#
# To serve the web build from another machine on the LAN, add that
# machine's origin — e.g. http://192.168.1.5:5173. A wildcard host is not
# supported by CORS, so each origin must be listed.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- PostgreSQL (business data + LangGraph checkpoints + Store) ---
DATABASE_URL=postgresql+asyncpg://algoforge:algoforge@localhost:5432/algoforge
# Optional: blocking-driver DSN for the synchronous API routes. Leave
# blank and app/db.py rewrites the asyncpg URL above to psycopg.
DATABASE_URL_SYNC=
LANGGRAPH_CHECKPOINT_URI=postgresql://algoforge:algoforge@localhost:5432/algoforge

# --- Milvus (RAG vector store) -------------------------------
MILVUS_URI=http://localhost:19530

# 内嵌 Milvus（milvus-lite）：给一个 .db 文件路径就走内嵌引擎，**不需要
# Docker**。留空才用 MILVUS_URI 去连服务。代码默认指向 sidecar/data/milvus.db，
# 因为本机 Docker 不通（wsl.exe 被安全策略拉黑），留空等于检索永久不可用。
# ⚠️ 显式写成 MILVUS_LITE_PATH=（空值）会覆盖掉那个默认值，退回连服务。
# MILVUS_LITE_PATH=

# --- 知识库检索（RAG）-----------------------------------------
# 检索要能用，必须有一个「把文字变成向量」的模型。大多数只提供对话的免费
# 端点**没有**这个能力（实测：把聊天模型当 embedding 用会被服务端明确拒绝）。
# 本机方案：用 Ollama 跑 bge-m3，完全本地、不消耗任何 API token。
RAG_ENABLED=true
EMBEDDING_PROVIDER=ollama          # ollama | openai_compatible | none
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# 首次调用要把模型从磁盘装进内存（本机实测 bge-m3 约 52 秒），之后每次约 4 秒。
# 30 秒会把「还在加载」误报成超时，看上去像是服务没起来。
EMBEDDING_TIMEOUT=180
# 模型在内存里留多久。留短了，隔一会儿的下一个提交要再付一次 52 秒的加载。
EMBEDDING_KEEP_ALIVE=30m
# 建索引 / 重建索引（**换 embedding 模型后必须 --recreate**：两个模型的向量
# 不可比，混在一个集合里会返回看起来像「相关性差」的乱码）：
#   sidecar/.venv/Scripts/python.exe tools/index_knowledge_base.py --recreate

# --- C++ compiler --------------------------------------------
# Path to g++. Use a bare `g++` to resolve it from PATH, or an absolute
# path. On this machine MinGW lives here:
#   CPP_COMPILER_PATH=D:\BaiduNetdiskDownload\dev\ucrt64\bin\g++.exe
# CPP_COMPILER_BIN_DIR defaults to the compiler's own directory, which is
# what MinGW needs so compiled binaries can find libstdc++/libgcc DLLs.
# Only set it if the runtime DLLs live somewhere other than next to g++.
CPP_COMPILER_PATH=g++
CPP_COMPILER_BIN_DIR=
CPP_STD=c++17
SANDBOX_TIMEOUT=10

# --- Python interpreter --------------------------------------
# Leave blank to run submissions with the interpreter that is running
# the sidecar itself (its venv). That is the only interpreter guaranteed
# to exist in this deployment, so it is the safe default. Set an absolute
# path only if submissions must use a different Python.
PYTHON_INTERPRETER_PATH=

# --- Java (JDK required) -------------------------------------
# A JRE is NOT sufficient: judging needs `javac`, which ships only with
# a JDK. Both settings accept a bare command name (resolved from PATH) or
# an absolute path. Few machines have a JDK on PATH, so if the language
# still shows as unavailable in /api/v1/env-check, point these at the
# JDK explicitly. On this machine the only JDK is 1.8.0_291:
#   JAVA_COMPILER_PATH=C:\Program Files\Java\jdk1.8.0_291\bin\javac.exe
#   JAVA_RUNTIME_PATH=C:\Program Files\Java\jdk1.8.0_291\bin\java.exe
#
# NOTE: it is JDK 8, so the Java starter template and any sample solution
# must stay within Java 8 syntax (no `var`, no switch expressions, no
# text blocks).
JAVA_COMPILER_PATH=javac
JAVA_RUNTIME_PATH=java

# Heap cap passed to the JVM as -Xmx. The runner's memory check measures
# OS-level resident memory, which a JVM trips on startup regardless of the
# program; a bounded heap makes it fail with OutOfMemoryError at a
# predictable point instead.
JAVA_MAX_HEAP_MB=256

# Extra resident memory tolerated for Java runs, on top of the request's
# mem_limit_mb, before the runner's OS-level check fires. A JVM's RSS is
# dominated by metaspace, the code cache and GC structures rather than by
# the submission's own allocation, so checking it against a C++-sized
# ceiling reports false MLE on correct code. The real Java bound is
# JAVA_MAX_HEAP_MB; this only keeps the OS-level check from firing first.
# Raise it if a correct Java submission is still reported as MLE.
JAVA_RSS_ALLOWANCE_MB=512
