# ============================================================
# AlgoForge .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# ---------- Node / Electron ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Electron
out/

# ---------- Environment & Secrets ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- IDE / Editor ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Project specific ----------
# Sidecar runtime artifacts
# NOTE: alembic migration scripts (sidecar/alembic/versions/*.py) are
# SOURCE CODE and must be versioned — AGENTS.md requires all schema
# changes to go through Alembic, so the migration history is part of
# the deliverable. Only the compiled cache is ignored.
sidecar/alembic/versions/__pycache__/
sidecar/*.db
sidecar/*.sqlite3

# Local assistant workspace state (memory/logs) — not part of the project
.workbuddy/
.workbuddy-ai/

# Milvus / Docker volumes (not tracked)
milvus_data/

# Generated logs
*.log
logs/

# PyInstaller build artifacts (S10)
sidecar/build/
sidecar/dist/
sidecar/*.spec

# PyInstaller / electron-builder 产物
dist-desktop/
# 换过几次名字：dist-desktop2/ 是早期的一次实验产物，dist-fresh/ 是 electron-builder
# 用 `-c.directories.output=` 输出到新目录时的落点（绕开本机沙箱的批量删除拦截，
# 见 night-queue.md 的 T3）。都不是源码，不进版本库。
dist-desktop2/
dist-fresh/
sidecar/packaging/*.spec

# 内嵌向量库（milvus-lite）的运行产物。它是 sidecar/data/milvus.db，由
# tools/index_knowledge_base.py 从 corpus/knowledge_cards/ 重建，不是数据源。
# 进版本库只会让二进制文件冲突，且换过 embedding 模型后它必须重建。
sidecar/data/
