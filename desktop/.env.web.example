# ============================================================
#  AlgoForge Web target — environment template
#  Copy to `.env.web` and fill in. `.env.web` is gitignored;
#  this file is not.
# ============================================================

# Which target this bundle is for. Nothing branches on it — the build
# alias picks the runtime implementation — but `vite.config.web.ts`
# asserts it, so copying the wrong env file fails the build instead of
# producing a bundle that behaves like the other target.
VITE_TARGET=web

# Where the sidecar is listening. The browser talks to it directly, so
# this must be an origin the browser can reach — not a container-internal
# name.
VITE_SIDECAR_URL=http://127.0.0.1:8000

# The sidecar's token. Leave blank only if the sidecar runs with
# SIDECAR_TOKEN unset *and* you accept 401s; normally you set the same
# value on both sides:
#
#   sidecar/.env:  SIDECAR_TOKEN=dev-local-token
#   desktop/.env.web:  VITE_SIDECAR_TOKEN=dev-local-token
#
# ⚠️  SECURITY BOUNDARY — READ THIS BEFORE DEPLOYING ANYWHERE
#
# Anything under `VITE_` is compiled into the bundle and is readable by
# anyone who loads the page. Putting the token here is acceptable only
# for what this target is for: a preview on the developer's own machine
# or a trusted LAN, talking to a sidecar that is likewise local.
#
# What that buys you, and what it does not:
#
# 1. THE SIDECAR NOW VERIFIES THE TOKEN. `app/main.py` installs
#    `SidecarTokenMiddleware` and `app/api/ws.py` checks the handshake,
#    so a request with no credential is refused with 401 rather than
#    served. The value below is therefore genuinely required — leave it
#    blank and every call 401s.
#
# 2. IT STILL DOES NOT MAKE A PUBLIC DEPLOYMENT SAFE. The credential is
#    in the bundle, so anyone who loads the page can read it: the check
#    stops strangers, not readers. And it is one shared secret — knowing
#    it makes you "the app", with no way to tell two users apart. The
#    missing pieces are TLS and a credential issued per user rather than
#    baked into a build artifact.
#
# Also still true: the sidecar binds to 127.0.0.1 and the CORS allowlist
# is narrow. Keep it that way. The origin allowlist is a browser rule,
# and anything that is not a browser ignores it entirely.
#
# For a public deployment, the correct design is a server that holds the
# credential and authenticates the *user* by session, so the browser
# never sees a sidecar credential at all. That is a different deployment
# and needs its own work — not a flag flip on this file.
VITE_SIDECAR_TOKEN=

# Dev-server origin, for reference when configuring the sidecar's
# CORS_ALLOW_ORIGINS. Defaults to 5173 and `strictPort` is on, so this
# value must match the port the dev server actually binds.
#   CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
