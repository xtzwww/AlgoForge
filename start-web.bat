@echo off
REM ============================================================
REM  CodeLab / Programming Practice Assistant -- Web edition launcher (idempotent)
REM
REM  Difference from start.bat (Electron desktop):
REM    - no native window; the UI opens in a browser;
REM    - no Vite dev server: build static assets first, then serve
REM      them with http.server. Reason: node_modules\.vite\deps has
REM      200+ files here and the dev server's startup cleanup gets
REM      blocked by the safe-delete bulk guard (threshold 50),
REM      failing with SAFE_DELETE_BULK_CONFIRM_REQUIRED. The build
REM      path never clears that cache, so it works.
REM
REM  This script is IDEMPOTENT: every step probes before starting.
REM  If a service is already up it is reused, so double-clicking
REM  twice no longer spawns a duplicate zombie. Use stop-web.bat.
REM
REM  Three services: PostgreSQL(5432) -> sidecar(8123) -> static(5179)
REM
REM  REBUILD POLICY (changed 2026-09-25): step 3 compares the source
REM  timestamps against the bundle and rebuilds when they are newer.
REM  It used to reuse dist-web whenever the bundle existed and carried
REM  the right port, which meant source edits produced NO visible
REM  change -- every service green, the page loading, and yesterday's
REM  UI in it. That reads as "my change did nothing" and cost an
REM  evening. The comparison itself lives in
REM  tools\web-bundle-stale.mjs so it can be tested; see that file.
REM
REM  Created 2026-09-24 (PU-12).
REM
REM  ENCODING: UTF-8 WITH BOM, and CRLF line endings. Both matter.
REM
REM  The BOM is what lets cmd run on code page 65001 and print Chinese.
REM  The CRLF is separate and was MISSING until 2026-10-04: the file had
REM  been rewritten with Unix LF endings, and cmd seeks by byte offset, so
REM  every CRLF-less line desynchronised the parse. The symptoms were
REM  nonsense like `'ser' is not recognized` (a word cut out of a REM) and
REM  the script dying before it started anything -- double-clicking just
REM  flashed and closed. A batch file with LF endings is not a batch file.
REM
REM  NOTE ON PROSE: every comment and every `echo` here is ASCII on
REM  purpose. With chcp 65001 cmd still mis-seeks past multibyte text in
REM  the lines it *re-reads* (blocks, `for /f`, `call` targets), and once
REM  the drift starts it eventually walks into the `:kill_port` body and
REM  runs a bare `netstat`, dumping its usage text into the window. That
REM  dump is cosmetic -- the launch still completes -- but it looks like a
REM  crash. The one Chinese string that must stay is the PYTHON_EXE path:
REM  it is real data (the account is named 雪团子), not prose, and a
REM  correctly-parsed file reaches it fine.
REM
REM  GOTCHA FIXED HERE: never put a `:label` inside a parenthesised
REM  block. cmd's block parser breaks and reports
REM  ") was unexpected at this time." The pg wait labels used to be
REM  inside the `if errorlevel 1 ( ... )` block; they now live at
REM  the bottom, outside every block.
REM ============================================================

setlocal enabledelayedexpansion

set "PROJECT_ROOT=%~dp0"
set "DESKTOP_DIR=%PROJECT_ROOT%desktop"
set "SIDECAR_DIR=%PROJECT_ROOT%sidecar"
set "NODE_DIR=d:\node"
set "PYTHON_EXE=C:\Users\雪团子\.workbuddy-ai\binaries\python\versions\3.13.12\python.exe"

REM --- ports and shared credential -----------------------------
set "SIDECAR_PORT=8123"
set "WEB_PORT=5179"
set "SIDECAR_TOKEN=dev-local-token"

REM --- 2.5 write desktop\.env.web ------------------------------
REM  The web bundle bakes VITE_SIDECAR_URL / VITE_SIDECAR_TOKEN in
REM  at BUILD time, so Vite needs these as a *file* before it runs.
REM  This used to be maintained by hand, and when the file was
REM  missing the bundle shipped with no backend address at all: the
REM  page reported "no analysis-engine address configured (VITE_SIDECAR_URL);
REM  the web edition cannot connect" while the sidecar was running fine.
REM  Written from the variables above so the port and token have one
REM  source of truth. This OVERWRITES local edits on purpose -- to
REM  point the web build somewhere else, change SIDECAR_PORT /
REM  SIDECAR_TOKEN above instead of editing .env.web.
set "ENV_WEB=%DESKTOP_DIR%\.env.web"
> "%ENV_WEB%" echo # AUTO-GENERATED by start-web.bat -- edits here are overwritten.
>>"%ENV_WEB%" echo # Change SIDECAR_PORT / SIDECAR_TOKEN in that script instead.
>>"%ENV_WEB%" echo VITE_TARGET=web
>>"%ENV_WEB%" echo VITE_SIDECAR_URL=http://127.0.0.1:%SIDECAR_PORT%
>>"%ENV_WEB%" echo VITE_SIDECAR_TOKEN=%SIDECAR_TOKEN%

REM --- pg wait state, used by the goto outside the blocks --------
set "PG_UP=0"

echo.
echo   ============================================
echo     Programming Practice Assistant -- Web edition
echo   ============================================
echo.

if not exist "%DESKTOP_DIR%\node_modules" (
  echo   [ERROR] desktop/node_modules is missing. Run: npm install
  pause
  exit /b 1
)
if not exist "%SIDECAR_DIR%\.venv\Scripts\python.exe" (
  echo   [ERROR] sidecar/.venv is missing. Create it and install dependencies.
  pause
  exit /b 1
)

set "PATH=%PATH%;%NODE_DIR%;%NODE_DIR%\node_modules\.bin"

REM --- 1. database ----------------------------------------------
REM  pg_isready only opens a socket, it does not run SQL: more
REM  reliable than an HTTP probe.
"D:\pg\pgsql\bin\pg_isready.exe" -h 127.0.0.1 -p 5432 >nul 2>&1
if not errorlevel 1 (
  echo   [1/4] PostgreSQL already running
  goto pg_checked
)

echo   [1/4] Starting PostgreSQL
REM  Must launch postgres.exe directly, NOT pg_ctl: on this box
REM  pg_ctl fails with an EMPTY log. COMSPEC is pointed at
REM  nocmd.exe to bypass the cmd.exe call inside postgres.exe,
REM  otherwise it reports "could not locate matching postgres
REM  executable" and again logs nothing.
set "COMSPEC=D:\pg\nocmd.exe"
pushd D:\pg
start "codelab-pg" /min "D:\pg\pgsql\bin\postgres.exe" -D "D:\pg\data"
popd

for /l %%i in (1,1,40) do (
  "D:\pg\pgsql\bin\pg_isready.exe" -h 127.0.0.1 -p 5432 >nul 2>&1
  if not errorlevel 1 set "PG_UP=1"
  if "!PG_UP!"=="1" goto pg_wait_done
  ping -n 2 127.0.0.1 >nul
)
:pg_wait_done
if "!PG_UP!"=="1" (
  echo         ready
) else (
  echo   [WARN] Database not ready within 40s -- problems and mistake book may fail
)

:pg_checked

REM --- 2. sidecar backend --------------------------------------
REM  /health is a shallow probe that does not touch the DB, so a
REM  200 means the process is really serving.
REM
REM  Serving is not the same as CURRENT, though, and this probe cannot
REM  tell the difference. It answered happily for a backend started
REM  hours earlier, so edits under sidecar\app had no visible effect
REM  until somebody killed the process by hand -- and the symptom was a
REM  live server returning 404 for a route that plainly exists on disk,
REM  which reads as a routing or frontend bug. It cost an afternoon.
REM
REM  So when something answers, ask it which revision it loaded. The
REM  sidecar publishes a fingerprint of its own sources on /health
REM  (sidecar\app\code_stamp.py); tools\sidecar-stale.mjs hashes the
REM  files on disk and compares. Different -> restart it here.
REM
REM  The helper prints 0 fresh / 1 stale / 2 cannot tell and ALWAYS exits
REM  0, for the reason spelled out at step 3 below: through `for /f` a
REM  non-zero exit is indistinguishable from "node is not installed". Only
REM  the literal 0 means reuse. Empty (node missing, script threw) and 2
REM  both restart, because reusing a process whose revision is unknown is
REM  exactly the bug this check exists to catch.
REM
REM  NOTE: `for /f` and the label below stay at the TOP LEVEL, never
REM  inside a parenthesised block -- see the header note about cmd's
REM  block parser. The one block here contains only `echo` and `goto`.
set "API_RUNNING=0"
curl -s --noproxy "*" -m 3 "http://127.0.0.1:%SIDECAR_PORT%/health" >nul 2>&1
if not errorlevel 1 set "API_RUNNING=1"
if "%API_RUNNING%"=="0" goto api_start

set "SIDECAR_STATE="
for /f "delims=" %%S in ('node "%PROJECT_ROOT%tools\sidecar-stale.mjs" "%SIDECAR_DIR%" %SIDECAR_PORT%') do set "SIDECAR_STATE=%%S"
if "%SIDECAR_STATE%"=="0" (
  echo   [2/4] Backend already running on %SIDECAR_PORT%
  goto api_checked
)

echo   [2/4] Backend running but code changed -- restarting %SIDECAR_PORT%
call :kill_port %SIDECAR_PORT% "backend sidecar"
REM  Give the socket a moment to be released. Binding a port that a
REM  just-killed process still holds fails, and the failure surfaces 40
REM  seconds later as "backend did not start" -- a wrong diagnosis of a wrong action.
ping -n 3 127.0.0.1 >nul

:api_start
echo   [2/4] Starting backend on %SIDECAR_PORT%
pushd "%SIDECAR_DIR%"
REM  Clear PYTHONPATH: the outer environment often points it at
REM  some other package tree which would shadow the venv.
set "PYTHONPATH="
REM  CORS must be explicit: browsers send an Origin header,
REM  Electron is naturally exempt.
set "CORS_ALLOW_ORIGINS=http://127.0.0.1:%WEB_PORT%,http://localhost:%WEB_PORT%,http://127.0.0.1:5173,http://localhost:5173"
REM  NOTE: this sets SIDECAR_TOKEN, which IS read, not the inert
REM  WEB_SIDECAR_TOKEN in sidecar/.env. A fixed token lets web and
REM  desktop share one backend, so a browser refresh does not
REM  force a re-login.
start "codelab-sidecar" /min ".venv\Scripts\python.exe" -u -m uvicorn app.main:app --host 127.0.0.1 --port %SIDECAR_PORT% --env-file .env
popd

set "API_UP=0"
for /l %%i in (1,1,40) do (
  curl -s --noproxy "*" -m 2 "http://127.0.0.1:%SIDECAR_PORT%/health" >nul 2>&1
  if not errorlevel 1 set "API_UP=1"
  if "!API_UP!"=="1" goto api_wait_done
  ping -n 2 127.0.0.1 >nul
)
:api_wait_done
if "!API_UP!"=="0" (
  echo   [ERROR] Backend did not start within 40s -- see the errors above.
  pause
  exit /b 1
)
echo         ready

REM --- 2.5 schema migrations --------------------------------------
REM  create_all only creates MISSING tables; it never adds a column to an
REM  existing one (sidecar\app\db.py). After a model gains a new column, not
REM  running this makes teacher-side queries 500 with e.g. "column
REM  submissions.style_flagged does not exist". The browser then sees no CORS
REM  headers and shows it as "Network Error". Alembic is the one entry point
echo   [2.5/4] Syncing database schema (alembic upgrade head)
pushd "%SIDECAR_DIR%"
".venv\Scripts\python.exe" -m alembic upgrade head
if errorlevel 1 (
  echo   [WARN] Migration failed -- teacher analytics may error (see alembic output above)
)
popd

:api_checked

REM --- 3. build web assets -------------------------------------
REM  Three reasons to rebuild, and they are checked in this order
REM  because each is cheaper than the next:
REM    1. the bundle is incomplete (missing entry / assets dir);
REM    2. the bundle was built for a DIFFERENT port. The address is
REM       compiled in, so a bundle built for another port keeps failing
REM       while every service is up -- a symptom that reads like a
REM       connectivity bug and is not one;
REM    3. the sources are newer than the bundle.
REM
REM  (3) is the one that used to be missing, and its absence is
REM  invisible: nothing errors, the old page just keeps working.
REM  NOTE: the Vite entry is index.web.html, NOT index.html.
set "NEED_BUILD=0"
if not exist "%DESKTOP_DIR%\dist-web\index.web.html" set "NEED_BUILD=1"
if not exist "%DESKTOP_DIR%\dist-web\teacher.web.html" set "NEED_BUILD=1"
if not exist "%DESKTOP_DIR%\dist-web\assets" set "NEED_BUILD=1"
findstr /m /c:"127.0.0.1:%SIDECAR_PORT%" "%DESKTOP_DIR%\dist-web\assets\*.js" >nul 2>&1
if errorlevel 1 set "NEED_BUILD=1"

REM  Only ask about freshness when the bundle is otherwise usable: the
REM  helper reads dist-web, and against a missing one its answer is
REM  "cannot tell" anyway.
REM
REM  The helper prints 0 fresh / 1 stale / 2 cannot tell, and ALWAYS
REM  exits 0 -- a non-zero exit through `for /f` is indistinguishable
REM  from "node is not installed". So the only value that means "reuse"
REM  is the literal 0: empty (node missing, script threw) and 2 both
REM  rebuild. Defaulting to reuse on an unknown is exactly how a stale
REM  bundle gets served with every light green.
set "BUNDLE_STATE="
if "%NEED_BUILD%"=="0" for /f "delims=" %%S in ('node "%PROJECT_ROOT%tools\web-bundle-stale.mjs" "%DESKTOP_DIR%"') do set "BUNDLE_STATE=%%S"
if "%NEED_BUILD%"=="0" if not "%BUNDLE_STATE%"=="0" set "NEED_BUILD=1"

REM  Stop the static server before clearing dist-web: its working
REM  directory IS dist-web, and Windows refuses to delete a directory
REM  that is some live process's CWD. Step 4 brings it back up.
REM
REM  Deliberately a single-line `if`, NOT a line inside the block below:
REM  this file has already been bitten once by cmd's block parser (see
REM  the header note about `:label`), so the subroutine call stays at
REM  the top level where nothing else is being parsed.
if "%NEED_BUILD%"=="1" call :kill_port %WEB_PORT% "web server"

if "%NEED_BUILD%"=="1" (
  echo   [3/4] Building web assets, about 1 minute
  REM  Clear the output dir with cmd's own rmdir instead of letting
  REM  Vite empty it. Vite deletes through Node, and Node on this box
  REM  carries a safe-delete shim that aborts any single batch over 50
  REM  files; dist-web\assets holds ~95, so the build died with
  REM  SAFE_DELETE_BULK_CONFIRM_REQUIRED instead of rebuilding. cmd's
  REM  rmdir does not go through Node and is not subject to that guard.
  if exist "%DESKTOP_DIR%\dist-web" rmdir /s /q "%DESKTOP_DIR%\dist-web"
  pushd "%DESKTOP_DIR%"
  call node_modules\.bin\vite build --config vite.config.web.ts --mode web
  if errorlevel 1 (
    echo   [ERROR] Build failed
    popd
    pause
    exit /b 1
  )
  popd
) else (
  echo   [3/4] Bundle is up to date, skipping build
)

REM --- 4. static server and browser ----------------------------
curl -s --noproxy "*" -m 3 "http://127.0.0.1:%WEB_PORT%/" >nul 2>&1
if errorlevel 1 (
  echo   [4/4] Starting web server on %WEB_PORT%
  pushd "%DESKTOP_DIR%\dist-web"
  start "codelab-web" /min "%PYTHON_EXE%" -m http.server %WEB_PORT% --bind 127.0.0.1
  popd
  ping -n 3 127.0.0.1 >nul
) else (
  echo   [4/4] Web server already running on %WEB_PORT%
)

REM --- 4.5 wait for the engine to finish its startup sweep ------
REM  /health going green is NOT the same as the engine being ready.
REM  The first GET /api/v1/env-check runs a version probe per language
REM  (cpp, python, java) and, on a cold start, that takes 30+ seconds --
REM  every compiler is launched for the first time. The endpoint is
REM  synchronous, so it also blocks the whole event loop while it runs.
REM
REM  Opening the browser before that settles gives a page that cannot
REM  reach the engine yet: the tab shows the BROWSER's own connection
REM  error, and clicking through to the other entry (the student/teacher
REM  switch on the sign-in page) fails the same way. Refreshing a minute
REM  later works, which makes it look random. It is not random, it is
REM  this window.
REM
REM  So: ask env-check once and wait for an answer before opening the
REM  tab. 60s is generous -- a warm start answers in about 2 seconds.
REM  Failure here is only a warning: the page can still be opened by
REM  hand, so do not abort the launch over it.
echo   [4.5/4] Waiting for the engine to finish probing toolchains
set "ENGINE_READY=0"
for /l %%i in (1,1,60) do (
  if "!ENGINE_READY!"=="0" (
    curl -s --noproxy "*" -m 90 -H "X-Sidecar-Token: %SIDECAR_TOKEN%" ^
      "http://127.0.0.1:%SIDECAR_PORT%/api/v1/env-check" >nul 2>&1
    if not errorlevel 1 set "ENGINE_READY=1"
    if "!ENGINE_READY!"=="0" ping -n 2 127.0.0.1 >nul
  )
)
if "!ENGINE_READY!"=="1" (
  echo         ready
) else (
  echo   [WARN] Engine did not finish probing in time; the page may need a refresh
)

REM  The entry is index.web.html, NOT index.html -- so the bare origin
REM  answers with a directory listing, not the app. Opening `/` sends
REM  people to a file list they then have to click through.
start "" "http://127.0.0.1:%WEB_PORT%/index.web.html"

echo.
echo   Opened    http://127.0.0.1:%WEB_PORT%/index.web.html   (student)
echo   Teacher   http://127.0.0.1:%WEB_PORT%/teacher.web.html   login: teacher / 123456
echo.
echo   To stop, run stop-web.bat. Closing this window does NOT stop the services.
echo.
pause
exit /b 0

REM ---- helper: stop whatever listens on a port -----------------
REM  %1 = port, %2 = display name. Silent when there is nothing to
REM  stop -- this runs mid-launch, where "nothing was running" is the
REM  normal case and not worth a line of output.
REM
REM  This label must stay OUTSIDE every parenthesised block AND after
REM  the `exit /b 0` above, otherwise cmd either reports
REM  ") was unexpected at this time." or falls into it on the way out.
:kill_port
for /f "tokens=5" %%p in ('netstat -ano ^| findstr /r /c:"127.0.0.1:%1 .*LISTENING"') do (
  echo         stopping %2 (port %1, PID %%p)
  taskkill /F /PID %%p >nul 2>&1
)
exit /b 0
